plugins {
    java
    id("org.springframework.boot") version "{{project.boot_version}}"
    id("io.spring.dependency-management") version "1.1.4"
    id("com.diffplug.spotless") version "6.23.3"
}

group = "{{project.group}}"
version = "{{project.version}}"

java {
    sourceCompatibility = JavaVersion.VERSION_{{project.java_version}}
}

configurations {
    compileOnly {
        extendsFrom(configurations.annotationProcessor.get())
    }
}

repositories {
    mavenCentral()
}

extra["testcontainersVersion"] = "1.19.7"

dependencies {
{{#each deps}}
    {{this}}
{{/each}}
}

dependencyManagement {
    imports {
        mavenBom("org.testcontainers:testcontainers-bom:${extra["testcontainersVersion"]}")
    }
}

spotless {
    java {
        googleJavaFormat("1.17.0")
        importOrder()
        removeUnusedImports()
        trimTrailingWhitespace()
        endWithNewline()
    }
}

tasks.withType<Test> {
    useJUnitPlatform()
}

tasks.bootJar {
    archiveFileName.set("${project.name}.jar")
}