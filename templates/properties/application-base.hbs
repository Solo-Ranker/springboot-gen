# ─────────────────────────────────────────────────────────
# Application — generated by SpringbootGen
# ─────────────────────────────────────────────────────────

spring:
  application:
    name: {{artifact}}
  profiles:
    active: ${SPRING_PROFILES_ACTIVE:dev}
  jackson:
    default-property-inclusion: non_null
    serialization:
      write-dates-as-timestamps: false
    deserialization:
      fail-on-unknown-properties: false

  {{#if has_kafka}}
  kafka:
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:{{kafka.bootstrap_servers}}}
    consumer:
      group-id: ${KAFKA_GROUP_ID:{{kafka.consumer_group_id}}}
      auto-offset-reset: {{kafka.auto_offset_reset}}
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      properties:
        spring.json.trusted.packages: "*"
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer
      retries: 3
      acks: all
      properties:
        enable.idempotence: true
    listener:
      concurrency: ${KAFKA_LISTENER_CONCURRENCY:{{kafka.listener_concurrency}}}
      ack-mode: BATCH
  {{/if}}

  {{#if has_db_standalone}}
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: "{{#if db_is_mysql}}org.hibernate.dialect.MySQL8Dialect{{else}}org.hibernate.dialect.PostgreSQLDialect{{/if}}"
        show_sql: false
        format_sql: true
    open-in-view: false
  {{/if}}

  {{#if has_mongodb}}
  data:
    mongodb:
      uri: mongodb://${MONGO_HOST:localhost}:${MONGO_PORT:27017}/${MONGO_DB:appdb}
      auto-index-creation: true
  {{/if}}

  {{#if has_elasticsearch}}
  elasticsearch:
    uris: ${ELASTICSEARCH_URIS:http://localhost:9200}
    username: ${ELASTICSEARCH_USER:elastic}
    password: ${ELASTICSEARCH_PASSWORD:elastic}
    socket-timeout: 10s
    connection-timeout: 3s
  {{/if}}

  {{#if has_oauth2}}
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${OAUTH2_ISSUER_URI:{{security.oauth2_issuer_uri}}}
  {{/if}}

  {{#if has_email}}
  mail:
    host: ${MAIL_HOST:localhost}
    port: ${MAIL_PORT:1025}
    username: ${MAIL_USER:}
    password: ${MAIL_PASSWORD:}
    properties:
      mail:
        smtp:
          auth: false
          starttls:
            enable: false
  {{/if}}

# ─────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────
server:
  port: ${SERVER_PORT:8080}
  shutdown: graceful
  compression:
    enabled: true
    mime-types: application/json,application/xml,text/html,text/plain
  error:
    include-message: always
    include-binding-errors: always

# ─────────────────────────────────────────────────────────
# Actuator
# ─────────────────────────────────────────────────────────
{{#if has_actuator}}
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus,env,loggers
  endpoint:
    health:
      show-details: when-authorized
      probes:
        enabled: true
  health:
    livenessstate:
      enabled: true
    readinessstate:
      enabled: true
  metrics:
    distribution:
      percentiles-histogram:
        http.server.requests: true
  info:
    env:
      enabled: true
    git:
      enabled: true
{{/if}}

# ─────────────────────────────────────────────────────────
# Tracing
# ─────────────────────────────────────────────────────────
{{#if has_tracing}}
management:
  tracing:
    sampling:
      probability: ${TRACING_SAMPLE_RATE:1.0}
  zipkin:
    tracing:
      endpoint: ${ZIPKIN_ENDPOINT:http://localhost:9411/api/v2/spans}

logging:
  pattern:
    level: "%5p [${spring.application.name:},%X{traceId:-},%X{spanId:-}]"
{{/if}}

# ─────────────────────────────────────────────────────────
# OpenAPI / Swagger
# ─────────────────────────────────────────────────────────
{{#if has_openapi}}
springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
    operations-sorter: alpha
    tags-sorter: alpha
    try-it-out-enabled: true
    display-request-duration: true
  info:
    title: {{project.name}} API
    version: v1
    description: "API documentation for {{project.name}}"
{{/if}}

# ─────────────────────────────────────────────────────────
# App-level custom config
# ─────────────────────────────────────────────────────────
app:
  name: ${spring.application.name}

  {{#if has_redis}}
  redis:
    mode: ${REDIS_MODE:standalone}   # standalone | sentinel | cluster
    ssl: true                        # set to false if no TLS
    standalone:
      host: ${REDIS_HOST:{{redis.host}}}
      port: ${REDIS_PORT:{{redis.port}}}
      password: ${REDIS_PASSWORD:}
      database: ${REDIS_DB:0}
    sentinel:
      master: ${REDIS_SENTINEL_MASTER:{{redis.sentinel.master}}}
      nodes: ${REDIS_SENTINEL_NODES:{{redis.sentinel.nodes}}}
      password: ${REDIS_PASSWORD:}
      sentinel-password: ${REDIS_SENTINEL_PASSWORD:}
      database: 0
    cluster:
      nodes: ${REDIS_CLUSTER_NODES:{{redis.cluster.nodes}}}
      password: ${REDIS_PASSWORD:}
      max-redirects: 3
    pool:
      max-active: {{redis.pool_max_active}}
      max-idle: {{redis.pool_max_idle}}
      min-idle: {{redis.pool_min_idle}}
      max-wait: 2000
      time-between-eviction-runs: 30000
  {{/if}}

  {{#if has_db_standalone}}
  datasource:
    type: ${DB_TYPE:{{db.type}}}
    host: ${DB_HOST:{{db.host}}}
    port: ${DB_PORT:{{db.port}}}
    database: ${DB_NAME:{{db.name}}}
    username: ${DB_USER:{{db.username}}}
    password: ${DB_PASSWORD:}
    ssl:
      enabled: true                        # set to false to disable
      mode: ${DB_SSL_MODE:require}         # disable|allow|prefer|require|verify-ca|verify-full
      root-cert-path: ${DB_SSL_ROOT_CERT:}
      cert-path: ${DB_SSL_CERT:}
      key-path: ${DB_SSL_KEY:}
      trust-server-certificate: false      # MySQL only: set true to skip CA verification
    pool:
      maximum-pool-size: {{db.pool_max_size}}
      minimum-idle: 2
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000
      keepalive-time: 60000
  flyway:
    enabled: {{db.flyway_enabled}}
    baseline-on-migrate: true
    baseline-version: "0"
    table: flyway_schema_history
    validate-on-migrate: true
    out-of-order: false
    locations:
      - classpath:db/migration
  {{/if}}

  {{#if has_db_replication}}
  datasource:
    type: ${DB_TYPE:{{db.type}}}
    master:
      host: ${DB_MASTER_HOST:{{db.host}}}
      port: ${DB_MASTER_PORT:{{db.port}}}
      database: ${DB_NAME:{{db.name}}}
      username: ${DB_MASTER_USER:{{db.username}}}
      password: ${DB_MASTER_PASSWORD:}
    slaves:
      - host: ${DB_SLAVE_HOST:{{db.host}}}
        port: ${DB_SLAVE_PORT:{{db.port}}}
        database: ${DB_NAME:{{db.name}}}
        username: ${DB_SLAVE_USER:{{db.username}}}
        password: ${DB_SLAVE_PASSWORD:}
    ssl:
      enabled: true
      mode: ${DB_SSL_MODE:require}
      root-cert-path: ${DB_SSL_ROOT_CERT:}
      cert-path: ${DB_SSL_CERT:}
      key-path: ${DB_SSL_KEY:}
    pool:
      maximum-pool-size: {{db.pool_max_size}}
      minimum-idle: 2
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000
      keepalive-time: 60000
  flyway:
    enabled: {{db.flyway_enabled}}
    baseline-on-migrate: true
    baseline-version: "0"
    table: flyway_schema_history
    validate-on-migrate: true
    out-of-order: false
    locations:
      - classpath:db/migration
  {{/if}}

  {{#if has_jwt}}
  jwt:
    secret: ${JWT_SECRET:change-me-in-production-with-a-256bit-key}
    access-token-expiry-ms: ${JWT_ACCESS_EXPIRY_MS:{{security.access_token_expiry_ms}}}
    refresh-token-expiry-ms: ${JWT_REFRESH_EXPIRY_MS:{{security.refresh_token_expiry_ms}}}
  {{/if}}

  {{#if has_email}}
  mail:
    from: ${MAIL_FROM:noreply@example.com}
  {{/if}}

  {{#if has_s3}}
  s3:
    bucket: ${S3_BUCKET:app-uploads}
    region: ${AWS_REGION:us-east-1}
    endpoint: ${S3_ENDPOINT:}
    path-style-access: ${S3_PATH_STYLE:false}
  {{/if}}

  {{#if has_websocket}}
  websocket:
    allowed-origins: ${WS_ALLOWED_ORIGINS:*}
    endpoint: /ws
    topic-prefix: /topic
    app-prefix: /app
  {{/if}}