package {{package}}.config;

import {{package}}.common.builder.JdbcUrlBuilder;
import {{package}}.config.properties.DatabaseProperties;
import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import java.util.Properties;
import javax.sql.DataSource;
import lombok.RequiredArgsConstructor;
import org.flywaydb.core.Flyway;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.boot.autoconfigure.flyway.FlywayMigrationInitializer;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.DependsOn;

/**
* Unified DataSource configuration supporting PostgreSQL and MySQL with optional SSL.
*
* <p>Bound from {@code app.datasource.*}. SSL is enabled by default
    * ({@code app.datasource.ssl.enabled=true}). For PostgreSQL, SSL is applied via
    * driver properties; for MySQL, it is embedded in the JDBC URL by {@link JdbcUrlBuilder}.
    */
    @Configuration
    @RequiredArgsConstructor
    @EnableConfigurationProperties(DatabaseProperties.class)
    public class DatabaseConfig {

    private final DatabaseProperties props;

    // ─── DataSource ───────────────────────────────────────────────────────────

    @Bean
    public DataSource dataSource() {
    HikariConfig config = new HikariConfig();
    config.setJdbcUrl(JdbcUrlBuilder.build(props));
    config.setUsername(props.getUsername());
    config.setPassword(props.getPassword());
    config.setDriverClassName(JdbcUrlBuilder.driverClassName(props.getType()));
    config.setPoolName("HikariPool-" + props.getType().toLowerCase());
    applyPoolConfig(config);
    applyDriverProperties(config);
    return new HikariDataSource(config);
    }

    // ─── Flyway ───────────────────────────────────────────────────────────────

    @Bean
    @ConditionalOnProperty(prefix = "app.datasource.flyway", name = "enabled", havingValue = "true", matchIfMissing =
    true)
    public Flyway flyway(DataSource dataSource) {
    DatabaseProperties.Flyway fw = props.getFlyway();
    if (fw == null || !fw.isEnabled()) return null;

    return Flyway.configure()
    .dataSource(dataSource)
    .baselineOnMigrate(fw.isBaselineOnMigrate())
    .baselineVersion(fw.getBaselineVersion())
    .table(fw.getTable())
    .validateOnMigrate(fw.isValidateOnMigrate())
    .outOfOrder(fw.isOutOfOrder())
    .locations(
    fw.getLocations() != null && !fw.getLocations().isEmpty()
    ? fw.getLocations().toArray(String[]::new)
    : new String[]{"classpath:db/migration"})
    .load();
    }

    @Bean
    @DependsOn("flyway")
    @ConditionalOnProperty(prefix = "app.datasource.flyway", name = "enabled", havingValue = "true")
    public FlywayMigrationInitializer flywayMigrationInitializer(Flyway flyway) {
    return new FlywayMigrationInitializer(flyway, Flyway::migrate);
    }

    // ─── Internals ────────────────────────────────────────────────────────────

    private void applyPoolConfig(HikariConfig config) {
    DatabaseProperties.Pool pool = props.getPool();
    if (pool == null) return;
    config.setMaximumPoolSize(pool.getMaximumPoolSize());
    config.setMinimumIdle(pool.getMinimumIdle());
    config.setConnectionTimeout(pool.getConnectionTimeout());
    config.setIdleTimeout(pool.getIdleTimeout());
    config.setMaxLifetime(pool.getMaxLifetime());
    config.setKeepaliveTime(pool.getKeepaliveTime());
    if (pool.getConnectionTestQuery() != null) {
    config.setConnectionTestQuery(pool.getConnectionTestQuery());
    }
    }

    // MySQL SSL is embedded in the URL — nothing extra needed here.
    // PostgreSQL passes SSL config through driver properties.
    private void applyDriverProperties(HikariConfig config) {
    if ("mysql".equalsIgnoreCase(props.getType())) return;

    DatabaseProperties.Ssl ssl = props.getSsl();
    Properties driverProps = new Properties();

    if (ssl == null || !ssl.isEnabled()) {
    driverProps.setProperty("ssl", "false");
    config.setDataSourceProperties(driverProps);
    return;
    }

    driverProps.setProperty("ssl", "true");
    driverProps.setProperty("sslmode", ssl.getMode());
    setIfPresent(driverProps, "sslrootcert", ssl.getRootCertPath());
    setIfPresent(driverProps, "sslcert", ssl.getCertPath());
    setIfPresent(driverProps, "sslkey", ssl.getKeyPath());
    config.setDataSourceProperties(driverProps);
    }

    private void setIfPresent(Properties driverProps, String key, String value) {
    if (value != null && !value.isBlank()) {
    driverProps.setProperty(key, value);
    }
    }
    }