package {{package}}.config;

import com.zaxxer.hikari.HikariDataSource;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Primary;

import javax.sql.DataSource;

/**
* MySQL SSL DataSource configuration.
*
* <p>Configures HikariCP with SSL mutual-TLS connections to MySQL 8.
    * Uses {@code useSSL=true}, {@code requireSSL=true}, and certificate verification.
    *
    *
<p>Generate development certificates:
    *
<pre>
 *   bash docker/mysql-ssl/generate-certs.sh
 * </pre>
*
* <p>Environment variables:
    *
<ul>
    * <li>DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD</li>
    * <li>DB_SSL_MODE — REQUIRED | VERIFY_CA | VERIFY_IDENTITY</li>
    * <li>DB_SSL_KEYSTORE / DB_SSL_KEYSTORE_PASSWORD — client keystore</li>
    * <li>DB_SSL_TRUSTSTORE / DB_SSL_TRUSTSTORE_PASSWORD — CA truststore</li>
    * </ul>
*/
@Configuration
public class MysqlSslConfig {

@Value("${spring.datasource.url}")
private String jdbcUrl;

@Value("${spring.datasource.username}")
private String username;

@Value("${spring.datasource.password:}")
private String password;

@Value("${spring.datasource.hikari.maximum-pool-size:10}")
private int maxPoolSize;

@Value("${DB_SSL_MODE:REQUIRED}")
private String sslMode;

@Value("${DB_SSL_KEYSTORE:classpath:ssl/db-client.p12}")
private String keystoreUrl;

@Value("${DB_SSL_KEYSTORE_PASSWORD:changeit}")
private String keystorePassword;

@Value("${DB_SSL_TRUSTSTORE:classpath:ssl/db-truststore.p12}")
private String truststoreUrl;

@Value("${DB_SSL_TRUSTSTORE_PASSWORD:changeit}")
private String truststorePassword;

@Primary
@Bean
public DataSource dataSource() {
var ds = new HikariDataSource();
ds.setJdbcUrl(jdbcUrl);
ds.setUsername(username);
ds.setPassword(password);
ds.setMaximumPoolSize(maxPoolSize);
ds.setMinimumIdle(2);
ds.setDriverClassName("com.mysql.cj.jdbc.Driver");

// MySQL Connector/J 8+ SSL properties
ds.addDataSourceProperty("sslMode", sslMode);
ds.addDataSourceProperty("clientCertificateKeyStoreUrl", keystoreUrl);
ds.addDataSourceProperty("clientCertificateKeyStorePassword", keystorePassword);
ds.addDataSourceProperty("trustCertificateKeyStoreUrl", truststoreUrl);
ds.addDataSourceProperty("trustCertificateKeyStorePassword", truststorePassword);

return ds;
}
}