apiVersion: v1
kind: ConfigMap
metadata:
  name: {{artifact}}-config
  namespace: {{artifact}}
data:
  SPRING_PROFILES_ACTIVE: "prod"
  SERVER_PORT: "{{port}}"
{{#if has_redis}}
  REDIS_HOST: redis-service
  REDIS_PORT: "6379"
{{/if}}
{{#if has_redis_sentinel}}
  REDIS_SENTINEL_MASTER: "mymaster"
  REDIS_SENTINEL_NODES: "redis-sentinel-0:26379,redis-sentinel-1:26379"
{{/if}}
{{#if has_kafka}}
  KAFKA_BOOTSTRAP_SERVERS: "kafka-service:9092"
{{/if}}
{{#if has_postgres}}
  DB_HOST: "postgres-service"
  DB_PORT: "5432"
{{/if}}
{{#if has_tracing}}
  ZIPKIN_ENDPOINT: "http://zipkin-service:9411/api/v2/spans"
{{/if}}