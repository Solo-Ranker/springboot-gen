# ─────────────────────────────────────────────────────────────────────────────
# redis-tls.conf — Redis server configuration with TLS
# Generated by SpringbootGen
# Mount this file into the container at /etc/redis/redis.conf
# ─────────────────────────────────────────────────────────────────────────────

# Disable plaintext port — TLS only
port 0
tls-port 6380

# TLS certificate files (mounted from ./certs via Docker volume)
tls-cert-file /tls/redis-server.crt
tls-key-file /tls/redis-server.key
tls-ca-cert-file /tls/ca.crt

# Require client authentication (mutual TLS)
tls-auth-clients yes

# TLS for replication (if this is a replica)
tls-replication yes

# TLS for cluster bus (if clustering)
# tls-cluster yes

# Connection settings
tcp-backlog 511
bind 0.0.0.0
timeout 0
tcp-keepalive 300

# Persistence
appendonly yes
appendfsync everysec

# Logging
loglevel notice
logfile ""