# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose — Redis SSL + Sentinel HA (1 master, 1 replica, 3 sentinels)
# Generated by SpringbootGen
#
# Usage:
# 1. Generate certs: bash docker/redis-ssl/generate-certs.sh
# 2. Start: docker-compose -f docker/redis-ssl/docker-compose-sentinel.yml up -d
# ─────────────────────────────────────────────────────────────────────────────
name: {{artifact}}-redis-ssl-sentinel

services:
redis-master:
image: redis:7.2-alpine
container_name: {{artifact}}-redis-master
restart: unless-stopped
command: redis-server /etc/redis/redis.conf
ports:
- "${REDIS_MASTER_PORT:-6379}:6380"
volumes:
- redis_master_data:/data
- ./certs:/tls:ro
- ./redis-tls.conf:/etc/redis/redis.conf:ro
healthcheck:
test: ["CMD", "redis-cli", "--tls",
"--cacert", "/tls/ca.crt",
"--cert", "/tls/redis-client.crt",
"--key", "/tls/redis-client.key",
"ping"]
interval: 10s
timeout: 5s
retries: 5
networks:
- redis-net

redis-replica-1:
image: redis:7.2-alpine
container_name: {{artifact}}-redis-replica-1
restart: unless-stopped
command: >
redis-server /etc/redis/redis.conf
--replicaof redis-master 6380
ports:
- "${REDIS_REPLICA1_PORT:-6380}:6380"
volumes:
- redis_replica1_data:/data
- ./certs:/tls:ro
- ./redis-tls.conf:/etc/redis/redis.conf:ro
depends_on:
redis-master:
condition: service_healthy
healthcheck:
test: ["CMD", "redis-cli", "--tls",
"--cacert", "/tls/ca.crt",
"--cert", "/tls/redis-client.crt",
"--key", "/tls/redis-client.key",
"ping"]
interval: 10s
timeout: 5s
retries: 5
networks:
- redis-net

redis-sentinel-1:
image: redis:7.2-alpine
container_name: {{artifact}}-redis-sentinel-1
restart: unless-stopped
command: redis-server /etc/redis/sentinel.conf --sentinel
ports:
- "${REDIS_SENTINEL1_PORT:-26379}:26379"
volumes:
- ./certs:/tls:ro
- ./redis-sentinel-tls.conf:/etc/redis/sentinel.conf:ro
depends_on:
redis-master:
condition: service_healthy
redis-replica-1:
condition: service_healthy
healthcheck:
test: ["CMD", "redis-cli", "--tls",
"--cacert", "/tls/ca.crt",
"--cert", "/tls/redis-client.crt",
"--key", "/tls/redis-client.key",
"-p", "26379", "ping"]
interval: 10s
timeout: 5s
retries: 5
networks:
- redis-net

redis-sentinel-2:
image: redis:7.2-alpine
container_name: {{artifact}}-redis-sentinel-2
restart: unless-stopped
command: redis-server /etc/redis/sentinel.conf --sentinel
ports:
- "${REDIS_SENTINEL2_PORT:-26380}:26379"
volumes:
- ./certs:/tls:ro
- ./redis-sentinel-tls.conf:/etc/redis/sentinel.conf:ro
depends_on:
redis-master:
condition: service_healthy
networks:
- redis-net

redis-sentinel-3:
image: redis:7.2-alpine
container_name: {{artifact}}-redis-sentinel-3
restart: unless-stopped
command: redis-server /etc/redis/sentinel.conf --sentinel
ports:
- "${REDIS_SENTINEL3_PORT:-26381}:26379"
volumes:
- ./certs:/tls:ro
- ./redis-sentinel-tls.conf:/etc/redis/sentinel.conf:ro
depends_on:
redis-master:
condition: service_healthy
networks:
- redis-net

networks:
redis-net:
name: {{artifact}}-redis-net

volumes:
redis_master_data:
name: {{artifact}}-redis-master-data
redis_replica1_data:
name: {{artifact}}-redis-replica1-data