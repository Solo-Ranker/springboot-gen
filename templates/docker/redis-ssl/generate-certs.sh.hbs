#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# generate-certs.sh — Redis TLS Certificate Generator
# Generated by SpringbootGen — for development/staging use.
# Replace with CA-signed certs in production.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CERTS_DIR="${SCRIPT_DIR}/certs"
DAYS=3650
ORG="SpringbootGen-Dev"
KEYPASS="changeit"
STOREPASS="changeit"

echo "🔐 Generating Redis TLS certificates in: ${CERTS_DIR}"
mkdir -p "${CERTS_DIR}"
cd "${CERTS_DIR}"

# ── 1. Certificate Authority ──────────────────────────────────────────────────
echo " → Generating CA key and certificate..."
openssl genrsa -out ca.key 4096
openssl req -new -x509 -days "${DAYS}" -key ca.key -out ca.crt \
-subj "/CN=redis-ca/O=${ORG}/OU=Dev"

# ── 2. Redis Server Certificate ───────────────────────────────────────────────
echo " → Generating Redis server certificate..."
openssl genrsa -out redis-server.key 2048
openssl req -new -key redis-server.key -out redis-server.csr \
-subj "/CN=redis-server/O=${ORG}/OU=Dev"
openssl x509 -req -in redis-server.csr -CA ca.crt -CAkey ca.key \
-CAcreateserial -out redis-server.crt -days "${DAYS}" \
-extfile <(echo "subjectAltName=DNS:redis,DNS:redis-master,DNS:localhost,IP:127.0.0.1" ) # ── 3. Redis Client
    Certificate ─────────────────────────────────────────────── echo "  → Generating Redis client certificate..."
    openssl genrsa -out redis-client.key 2048 openssl req -new -key redis-client.key -out redis-client.csr \
    -subj "/CN=redis-client/O=${ORG}/OU=Dev" openssl x509 -req -in redis-client.csr -CA ca.crt -CAkey ca.key \
    -CAcreateserial -out redis-client.crt -days "${DAYS}" # ── 4. PKCS12 Keystores for Spring Boot
    ────────────────────────────────────── echo "  → Creating Spring Boot PKCS12 keystores..." # Client keystore (for
    the Java app) openssl pkcs12 -export \ -in redis-client.crt -inkey redis-client.key \ -CAfile ca.crt -chain \
    -name "redis-client" \ -out redis-client.p12 \ -passout "pass:${KEYPASS}" # Truststore (contains the CA cert that
    signed the server cert) keytool -importcert \ -alias redis-ca \ -file ca.crt \ -keystore redis-truststore.p12 \
    -storetype PKCS12 \ -storepass "${STOREPASS}" \ -noprompt # ── 5. Copy keystores to Spring resources
    ──────────────────────────────────── RESOURCES_SSL="$(dirname " ${SCRIPT_DIR}/certs")/../../src/main/resources/ssl"
    if [ -d "${RESOURCES_SSL}" ] || mkdir -p "${RESOURCES_SSL}" 2>/dev/null; then
    echo " → Copying keystores to src/main/resources/ssl/"
    cp redis-client.p12 redis-truststore.p12 "${RESOURCES_SSL}/"
    fi

    # ── 6. Fix file permissions for Docker ───────────────────────────────────────
    chmod 600 ca.key redis-server.key redis-client.key
    chmod 644 ca.crt redis-server.crt redis-client.crt redis-client.p12 redis-truststore.p12

    echo ""
    echo "✅ Certificates generated successfully!"
    echo ""
    echo "Files in ${CERTS_DIR}:"
    ls -la "${CERTS_DIR}"
    echo ""
    echo "⚠️ IMPORTANT: These are SELF-SIGNED certificates for development only."
    echo " Replace ca.crt/server.crt/client.crt with CA-signed certificates in production."
    echo ""
    echo "Next steps:"
    echo " 1. docker-compose -f docker/redis-ssl/docker-compose.yml up -d"
    echo " 2. Update .env: REDIS_SSL_KEYSTORE=classpath:ssl/redis-client.p12"