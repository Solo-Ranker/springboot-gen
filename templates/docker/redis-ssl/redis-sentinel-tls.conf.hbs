# ─────────────────────────────────────────────────────────────────────────────
# redis-sentinel-tls.conf — Sentinel configuration with TLS
# Generated by SpringbootGen
# Replace SENTINEL_PORT with 26379 / 26380 / 26381 per sentinel node.
# ─────────────────────────────────────────────────────────────────────────────

# Disable plaintext sentinel port
port 0

# TLS sentinel port
sentinel tls-port 26379

# TLS certificates (same certs as Redis nodes)
tls-cert-file /tls/redis-server.crt
tls-key-file /tls/redis-server.key
tls-ca-cert-file /tls/ca.crt
tls-auth-clients yes
tls-replication yes

# Monitor the Redis master
# sentinel monitor <name>
    <ip>
        <port>
            <quorum>
                sentinel monitor mymaster redis-master 6380 2

                # Auth passwords (if set on Redis nodes)
                # sentinel auth-pass mymaster <password>

                    # Timeouts
                    sentinel down-after-milliseconds mymaster 5000
                    sentinel failover-timeout mymaster 60000
                    sentinel parallel-syncs mymaster 1

                    # Announce TLS port to other sentinels / clients
                    # sentinel announce-tls-port 26379