# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose — Redis standalone with TLS
# Generated by SpringbootGen
#
# Usage:
# 1. Generate certs: bash docker/redis-ssl/generate-certs.sh
# 2. Start: docker-compose -f docker/redis-ssl/docker-compose.yml up -d
# ─────────────────────────────────────────────────────────────────────────────
name: {{artifact}}-redis-ssl

services:
redis:
image: redis:7.2-alpine
container_name: {{artifact}}-redis
restart: unless-stopped
command: >
redis-server /etc/redis/redis.conf
ports:
- "${REDIS_PORT:-6380}:6380"
volumes:
- redis_data:/data
- ./certs:/tls:ro
- ./redis-tls.conf:/etc/redis/redis.conf:ro
healthcheck:
test: ["CMD", "redis-cli", "--tls",
"--cacert", "/tls/ca.crt",
"--cert", "/tls/redis-client.crt",
"--key", "/tls/redis-client.key",
"ping"]
interval: 10s
timeout: 5s
retries: 5
start_period: 10s
environment:
- REDIS_PASSWORD=${REDIS_PASSWORD:-}
networks:
- redis-net

networks:
redis-net:
name: {{artifact}}-redis-net

volumes:
redis_data:
name: {{artifact}}-redis-data