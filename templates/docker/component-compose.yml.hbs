# ─────────────────────────────────────────────────────────
# {{feature_name}} Docker Compose
# Generated by SpringbootGen
# ─────────────────────────────────────────────────────────
name: {{feature_key}}

services:
{{#each infra_services}}
  # ─────────────────────────────────────────────────────────
  # {{this.name}}
  # ─────────────────────────────────────────────────────────
  {{this.name}}:
    image: {{this.image}}
    container_name: {{this.name}}
    {{#if this.ports}}
    ports:
{{#each this.ports}}
      - "{{this}}"
{{/each}}
    {{/if}}
    {{#if this.environment}}
    environment:
{{#each this.environment}}
      {{@key}}: {{this}}
{{/each}}
    {{/if}}
    {{#if this.volumes}}
    volumes:
{{#each this.volumes}}
      - {{this}}
{{/each}}
    {{/if}}
    {{#if this.healthcheck}}
    healthcheck:
      test: ["CMD-SHELL", "{{this.healthcheck}}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    {{/if}}
    {{#if this.depends_on}}
    depends_on:
{{#each this.depends_on}}
      {{this}}:
        condition: service_healthy
{{/each}}
    {{/if}}
    restart: unless-stopped
    networks:
      - app-network

{{/each}}
networks:
  app-network:
    driver: bridge

{{#if volumes}}
volumes:
{{#each volumes}}
  {{this}}:
{{/each}}
{{/if}}
